# Correo (sin SMTP los correos se guardan en data/outbox en modo simulado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Radar viral <radar@tudominio.com>"
MAIL_TO=tu@correo.com

# Horas de envío del correo (hora de Madrid)
DIGEST_HOURS=9,14,20
# Minutos entre ingestas
INGEST_EVERY_MINUTES=5

# Opcional: segundo filtro con Claude para política/deportes
ANTHROPIC_API_KEY=

# Ruta de la base de datos
RADAR_DB=data/radar.db
